{
    "name": "design-docs",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "vite",
        "preview": "vite preview",
        "build": "vite build && rm -rf ../../docs && mkdir ../../docs && cp -R dist/ ../../docs && cp ../../CNAME ../../docs && cp ../../.nojekyll ../../docs",
        "test": "vitest run",
        "test:dev": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src/**/*.{ts,vue}",
        "lint:fix": "eslint --fix src/**/*.{ts,vue}",
        "format": "prettier -c 'src/**/*.{ts,vue,scss,spec.ts}'",
        "format:fix": "prettier --write 'src/**/*.{ts,vue,scss,spec.ts}'"
    },
    "devDependencies": {
        "@eslint/js": "^9.34.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vitest/coverage-v8": "^3.2.4",
        "@vue/test-utils": "^2.4.6",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "5.5.4",
        "eslint-plugin-vue": "^10.4.0",
        "globals": "^16.3.0",
        "highlight.js": "^11.11.1",
        "jsdom": "^26.1.0",
        "prettier": "^3.6.2",
        "protean-elements": "workspace:^",
        "protean-styles": "workspace:^",
        "sass": "^1.91.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.42.0",
        "vite": "^7.1.4",
        "vitest": "^3.2.4",
        "vue": "^3.5.21",
        "vue-eslint-parser": "^10.2.0",
        "vue-router": "^4.5.1"
    }
}
